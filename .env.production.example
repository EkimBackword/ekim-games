# Скопируйте в .env.production и замените все placeholder-значения.
POSTGRES_PASSWORD=replace-with-random-hex-password
MIGRATION_DB_PASSWORD=replace-with-a-different-random-hex-password
APP_DB_PASSWORD=replace-with-a-different-random-hex-password
JWT_ACCESS_SECRET=replace-with-at-least-32-random-bytes
JWT_REFRESH_SECRET=replace-with-a-different-32-byte-random-secret
WEB_ORIGIN=https://games.example.com
COOKIE_SECURE=true
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8080
