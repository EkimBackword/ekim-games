{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": [
    "/**",
    "!/**/*.*",
    "!/api/**",
    "!/socket.io/**"
  ],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/icons/**",
          "/*.css",
          "/*.js",
          "/assets/taiga-ui/icons/eye.svg",
          "/assets/taiga-ui/icons/eye-off.svg"
        ]
      }
    }
  ]
}
