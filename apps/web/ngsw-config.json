{
  "$schema": "../../node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "navigationUrls": ["/**", "!/**/*.*", "!/api/**", "!/socket.io/**"],
  "assetGroups": [
    {
      "name": "app-shell",
      "installMode": "prefetch",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/index.html",
          "/favicon.ico",
          "/manifest.webmanifest",
          "/icons/**",
          "/assets/rpg/icons/favicon.ico",
          "/assets/rpg/icons/favicon-16x16.png",
          "/assets/rpg/icons/favicon-32x32.png",
          "/assets/rpg/icons/apple-touch-icon.png",
          "/assets/rpg/icons/icon-192x192.png",
          "/assets/rpg/icons/icon-512x512.png",
          "/assets/rpg/icons/maskable-icon-192x192.png",
          "/assets/rpg/icons/maskable-icon-512x512.png",
          "/*.css",
          "/*.js",
          "/assets/taiga-ui/icons/eye.svg",
          "/assets/taiga-ui/icons/eye-off.svg",
          "/assets/taiga-ui/icons/clock.svg",
          "/assets/taiga-ui/icons/check.svg",
          "/assets/taiga-ui/icons/triangle-alert.svg"
        ]
      }
    }
  ]
}
